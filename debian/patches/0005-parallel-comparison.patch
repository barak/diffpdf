 MainWindow::MainWindow(const Debug debug,
@@ -1426,40 +1429,87 @@ const QPair<int, int> MainWindow::comparePages(const QString &filename1,
     QList<int> pages1 = getPageList(1, pdf1);
     QList<int> pages2 = getPageList(2, pdf2);
     int total = qMin(pages1.count(), pages2.count());
-    int number = 0;
+
+    // Pages are compared in parallel, but only the thread that called us
+    // (OpenMP thread 0, the GUI thread) may touch widgets or process events.
+    // Results and messages are therefore collected per page pair and
+    // reported in order once the parallel loop has finished.
+    QVector<Difference> difference(total, NoDifference);
+    QVector<bool> compared(total, false);
+    QVector<QString> error(total);
+    // Threads write through these rather than QVector::operator[], which
+    // may detach
+    Difference *const differenceData = difference.data();
+    bool *const comparedData = compared.data();
+    QString *const errorData = error.data();
+    int processed = 0;
+
+#pragma omp parallel
+    {
+        // A Poppler document must not be rendered from several threads at
+        // once, so each thread works on its own copies.
+        PdfDocument doc1(Poppler::Document::load(filename1));
+        PdfDocument doc2(Poppler::Document::load(filename2));
+        for (int bit = 1; doc1 && doc2 && bit <= 0x100; bit <<= 1) {
+            const Poppler::Document::RenderHint hint =
+                    static_cast<Poppler::Document::RenderHint>(bit);
+            doc1->setRenderHint(hint, pdf1->renderHints().testFlag(hint));
+            doc2->setRenderHint(hint, pdf2->renderHints().testFlag(hint));
+        }
+#pragma omp for schedule(dynamic)
+        for (int i = 0; i < total; ++i) {
+            if (cancel)
+                continue;
+            const int p1 = pages1.at(i);
+            const int p2 = pages2.at(i);
+            PdfPage page1(doc1 ? doc1->page(p1) : 0);
+            PdfPage page2(doc2 ? doc2->page(p2) : 0);
+            if (!page1)
+                errorData[i] = tr("Failed to read page %1 from '%2'.")
+                              .arg(p1 + 1).arg(filename1);
+            else if (!page2)
+                errorData[i] = tr("Failed to read page %1 from '%2'.")
+                              .arg(p2 + 1).arg(filename2);
+            else
+                differenceData[i] = getTheDifference(page1, page2);
+            comparedData[i] = true;
+            int done;
+#pragma omp atomic capture
+            done = ++processed;
+#ifdef _OPENMP
+            if (omp_get_thread_num() == 0)
+#endif
+            {
+                statusLabel->setText(tr("Comparing %1/%2").arg(done)
+                                                          .arg(total));
+                QApplication::processEvents();
+            }
+        }
+    }
+
     int index = 0;
-    while (!pages1.isEmpty() && !pages2.isEmpty()) {
-        int p1 = pages1.takeFirst();
-        PdfPage page1(pdf1->page(p1));
-        if (!page1) {
-            writeError(tr("Failed to read page %1 from '%2'.")
-                          .arg(p1 + 1).arg(filename1));
+    int number = 0;
+    for (int i = 0; i < total; ++i) {
+        if (!compared[i])
             continue;
-        }
-        int p2 = pages2.takeFirst();
-        PdfPage page2(pdf2->page(p2));
-        if (!page2) {
-            writeError(tr("Failed to read page %1 from '%2'.")
-                          .arg(p2 + 1).arg(filename2));
+        const int p1 = pages1.at(i);
+        const int p2 = pages2.at(i);
+        if (!error[i].isEmpty()) {
+            writeError(error[i]);
             continue;
         }
         writeLine(tr("Comparing: %1 vs. %2.").arg(p1 + 1).arg(p2 + 1));
-        QApplication::processEvents();
-        if (cancel) {
-            writeError(tr("Cancelled."));
-            break;
-        }
-        Difference difference = getTheDifference(page1, page2);
-        if (difference != NoDifference) {
+        ++number;
+        if (difference[i] != NoDifference) {
             QVariant v;
-            v.setValue(PagePair(p1, p2, difference == VisualDifference));
+            v.setValue(PagePair(p1, p2, difference[i] == VisualDifference));
             viewDiffComboBox->addItem(tr("%1 vs. %2 %3 %4")
                     .arg(p1 + 1).arg(p2 + 1).arg(QChar(0x2022))
                     .arg(++index), v);
         }
-        statusLabel->setText(tr("Comparing %1/%2").arg(++number)
-                                                  .arg(total));
     }
+    if (cancel)
+        writeError(tr("Cancelled."));
     return qMakePair(number, total);
 }
 
