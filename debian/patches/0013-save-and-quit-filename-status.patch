+// Compare without user interaction, save any differences, and exit with
+// a status like that of diff(1): 0 if the files appear to be the same,
+// 1 if they differ, and 2 if there was trouble.
+void MainWindow::saveAndQuitCompare(const QString &filename1,
+                                    const QString &filename2)
+{
+    if (filename1.isEmpty() || filename2.isEmpty()) {
+        reportError(tr("--save-and-quit needs two PDF files to compare."));
+        QApplication::exit(2);
+        return;
+    }
+    PdfDocument pdf1 = getPdf(filename1);
+    PdfDocument pdf2 = getPdf(filename2);
+    if (!pdf1 || !pdf2) {
+        QApplication::exit(2);
+        return;
+    }
+    if (QFileInfo(filename1).canonicalFilePath() ==
+        QFileInfo(filename2).canonicalFilePath()) {
+        QApplication::exit(0); // A file is the same as itself
+        return;
+    }
+    // Both line edits start out holding the names given on the command
+    // line, so setFile1() must not see filename2 there yet.
+    filename2LineEdit->clear();
+    setFile1(filename1);
+    setFile2(filename2);
+    pagesCompared = 0;
+    compare();
+    if (pagesCompared == 0) {
+        reportError(tr("No pages were compared."));
+        QApplication::exit(2);
+        return;
+    }
+    // Item 0 of viewDiffComboBox is "(Not viewing)"
+    const int count = viewDiffComboBox->count();
+    if (count <= 1) {
+        QApplication::exit(0);
+        return;
+    }
+    saveFilename = saveAndQuitFilename;
+    {
+        QFile file(saveFilename);
+        if (!file.open(QIODevice::WriteOnly)) {
+            reportError(tr("Cannot write '%1': %2.").arg(saveFilename)
+                        .arg(file.errorString()));
+            QApplication::exit(2);
+            return;
+        }
+    }
+    saveAsPdf(1, count, pdf1, pdf2, filename1 + " - " + filename2);
+    if (!QFileInfo(saveFilename).isFile()) {
+        reportError(tr("Failed to write '%1'.").arg(saveFilename));
+        QApplication::exit(2);
+        return;
+    }
+    QApplication::exit(1);
+}
